require 'json'
require 'fileutils'

default_platform(:ios)

platform :android do
  desc 'AAB → Google Play'
  lane :ship do
    UI.user_error!("PLAY_SERVICE_ACCOUNT_JSON boş. `ship play <anahtar.json>` ile yükle (README → Google Play).") if ENV['PLAY_SERVICE_ACCOUNT_JSON'].to_s.strip.empty?
    upload_to_play_store(
      package_name: ENV.fetch('PACKAGE_NAME'),
      aab: ENV.fetch('AAB'),
      track: ENV['TRACK'].to_s.empty? ? 'internal' : ENV['TRACK'],
      release_status: ENV['STATUS'].to_s.empty? ? 'completed' : ENV['STATUS'],
      json_key_data: ENV.fetch('PLAY_SERVICE_ACCOUNT_JSON'),
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end

platform :ios do
  desc 'Imzala + archive + TestFlight'
  lane :ship do
    p12_path = ENV.fetch('IOS_P12_PATH')
    p12_pass = ENV.fetch('IOS_DIST_CERT_PASSWORD')

    # Sertifikanın içinden gerçek Apple Team ID (OU) değerini otomatik çıkar (Yanlış Team ID girilmesini %100 önler)
    cert_team_id = `openssl pkcs12 -in "#{p12_path}" -passin pass:"#{p12_pass}" -nokeys 2>/dev/null | openssl x509 -noout -subject -nameopt RFC2253 2>/dev/null`[/OU=([A-Z0-9]{10})/, 1]
    team_id = (cert_team_id && !cert_team_id.empty?) ? cert_team_id : ENV.fetch('APPLE_TEAM_ID')
    UI.message("🔑 Aktif Apple Team ID: #{team_id}")

    api_key = app_store_connect_api_key(
      key_id: ENV.fetch('ASC_KEY_ID'),
      issuer_id: ENV.fetch('ASC_ISSUER_ID'),
      key_content: ENV.fetch('ASC_PRIVATE_KEY')
    )

    targets = JSON.parse(ENV.fetch('IOS_TARGETS_JSON'))
    main_bundle = ENV.fetch('IOS_BUNDLE_ID')

    app = Spaceship::ConnectAPI::App.find(main_bundle)
    if app.nil?
      UI.user_error!("App Store Connect'te '#{main_bundle}' uygulama kaydı yok. appstoreconnect.apple.com → Apps → + ile bir kez oluştur.")
    end

    # App Store Connect'teki mevcut sürüm ve son TestFlight build numarasını otomatik çek
    store_version = nil
    begin
      versions = app.get_app_store_versions
      store_version = versions.first&.version_string if versions && !versions.empty?
    rescue => e
      UI.message("App Store sürümü okunamadı: #{e.message}")
    end

    latest_build = 0
    begin
      latest_build = latest_testflight_build_number(
        api_key: api_key,
        app_identifier: main_bundle,
        initial_build_number: 0
      ).to_i
    rescue => e
      UI.message("TestFlight son build okunamadı: #{e.message}")
    end

    # Geçici keychain + ortak Apple Distribution sertifikası
    setup_ci(force: true)
    import_certificate(
      certificate_path: p12_path,
      certificate_password: p12_pass,
      keychain_name: 'fastlane_tmp_keychain',
      keychain_password: ''
    )

    profiles = {}
    targets.each do |t|
      bundle = t['bundle']
      if Spaceship::ConnectAPI::BundleId.find(bundle).nil?
        UI.important("Bundle ID oluşturuluyor: #{bundle}")
        Spaceship::ConnectAPI::BundleId.create(name: bundle.tr('.', ' '), platform: 'IOS', identifier: bundle)
      end

      get_provisioning_profile(
        api_key: api_key,
        app_identifier: bundle,
        team_id: team_id,
        provisioning_name: "Shipper AppStore #{bundle}",
        ignore_profiles_with_different_name: true
      )
      profiles[bundle] = lane_context[SharedValues::SIGH_NAME]
      prof_path = lane_context[SharedValues::SIGH_PROFILE_PATH]
      prof_uuid = lane_context[SharedValues::SIGH_UUID]

      # Hem Xcode 15 hem Xcode 16/26 dizinlerine profili garanti olarak kopyala
      if prof_path && File.exist?(prof_path) && prof_uuid
        [
          File.expand_path('~/Library/MobileDevice/Provisioning Profiles'),
          File.expand_path('~/Library/Developer/Xcode/UserData/Provisioning Profiles')
        ].each do |dir|
          FileUtils.mkdir_p(dir)
          FileUtils.cp(prof_path, File.join(dir, "#{prof_uuid}.mobileprovision"))
        end
      end

      update_code_signing_settings(
        path: ENV.fetch('IOS_PROJECT'),
        targets: [t['target']],
        use_automatic_signing: false,
        team_id: team_id,
        code_sign_identity: 'Apple Distribution',
        profile_name: profiles[bundle],
        profile_uuid: prof_uuid,
        bundle_identifier: bundle
      )
    end

    # Build numarasını ve sürümü belirle (TestFlight'taki son build + 1 veya kullanıcı girdisi)
    raw_version = ENV['VERSION'].to_s.strip
    ver_part, custom_build_part = raw_version.include?('+') ? raw_version.split('+', 2) : [raw_version, '']
    custom_build_part = ENV['CUSTOM_BUILD_NUMBER'].to_s.strip if custom_build_part.to_s.empty?

    requested_build = ENV['BUILD_NUMBER'].to_s.strip
    next_build = (latest_build + 1).to_s
    final_build = if !custom_build_part.to_s.empty?
                    custom_build_part.strip
                  elsif latest_build < 100_000
                    next_build
                  else
                    [requested_build.to_i, latest_build + 1].max.to_s
                  end

    final_version = ver_part.to_s.strip
    UI.success("📦 Mağaza Sürümü: #{store_version || 'Belirsiz'} | TestFlight Son Build: #{latest_build} → Yeni Gönderilen Build: ##{final_build}")

    cpu = (`sysctl -n hw.ncpu`.to_i rescue 3)
    cpu = 3 if cpu <= 0
    xcargs = [
      "CURRENT_PROJECT_VERSION=#{final_build}",
      'COMPILER_INDEX_STORE_ENABLE=NO',
      "DEVELOPMENT_TEAM=#{team_id}",
      'DEBUG_INFORMATION_FORMAT=dwarf',
      'ENABLE_TESTABILITY=NO',
      'ONLY_ACTIVE_ARCH=NO',
      'SWIFT_COMPILATION_MODE=wholemodule',
      '-skipPackagePluginValidation',
      '-skipMacroValidation',
      "-jobs #{cpu}"
    ]
    xcargs << "MARKETING_VERSION=#{final_version}" unless final_version.empty?

    container = ENV['IOS_WORKSPACE'].to_s.empty? ? { project: ENV['IOS_PROJECT'] } : { workspace: ENV['IOS_WORKSPACE'] }
    container[:cloned_source_packages_path] = ENV['IOS_SPM_DIR'] unless ENV['IOS_SPM_DIR'].to_s.empty?
    container[:derived_data_path] = ENV['IOS_DERIVED_DIR'] unless ENV['IOS_DERIVED_DIR'].to_s.empty?
    ipa = build_app(
      **container,
      scheme: ENV.fetch('IOS_SCHEME'),
      configuration: 'Release',
      export_method: 'app-store',
      export_team_id: team_id,
      export_options: { signingStyle: 'manual', provisioningProfiles: profiles, manageAppVersionAndBuildNumber: false },
      xcargs: xcargs.join(' '),
      output_directory: File.join(ENV.fetch('RUNNER_TEMP', '/tmp'), 'ipa'),
      skip_profile_detection: true,
      include_symbols: false,
      include_bitcode: false,
      xcodebuild_formatter: '',
      suppress_xcode_output: false
    )

    upload_to_testflight(
      api_key: api_key,
      ipa: ipa,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false
    )
  end
end
