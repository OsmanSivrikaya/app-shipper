{
  "name": "app-shipper",
  "version": "1.1.0",
  "private": true,
  "author": "Osman Sivrikaya <osman@appshipper.studio>",
  "description": "Tek tıkla herhangi bir mobil uygulamayı TestFlight + Google Play'e gönderir (Masaüstü Stüdyo + CLI)",
  "type": "module",
  "main": "desktop/main.mjs",
  "bin": {
    "ship": "bin/ship.mjs"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac"
  },
  "build": {
    "appId": "com.osmansivrikaya.appshipper",
    "productName": "App Shipper Studio",
    "icon": "desktop/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "desktop/**/*",
      "bin/**/*",
      "scripts/**/*",
      "fastlane/**/*",
      ".github/**/*",
      "Gemfile",
      "package.json"
    ],
    "win": {
      "icon": "desktop/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "App Shipper Studio",
      "installerIcon": "desktop/icon.ico",
      "uninstallerIcon": "desktop/icon.ico",
      "installerHeaderIcon": "desktop/icon.ico"
    },
    "mac": {
      "icon": "desktop/icon.png",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
